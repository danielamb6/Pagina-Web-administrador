        function generarPDFReal(tickets, filtros) {
            // Crear PDF con jsPDF
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');
            
            // Configuración inicial
            const pageWidth = pdf.internal.pageSize.getWidth();
            let yPos = 20;
            
            // Título
            pdf.setFontSize(20);
            pdf.setTextColor(26, 41, 128); // primary-blue
            pdf.text('REPORTE DE INCIDENCIAS', pageWidth / 2, yPos, { align: 'center' });
            yPos += 10;
            
            // Fecha de generación
            pdf.setFontSize(10);
            pdf.setTextColor(102, 102, 102); // text-secondary
            pdf.text(`Generado: ${new Date().toLocaleString('es-ES')}`, pageWidth / 2, yPos, { align: 'center' });
            yPos += 15;
            
            // Filtros aplicados
            pdf.setFontSize(12);
            pdf.setTextColor(51, 51, 51); // text-primary
            pdf.text('Filtros Aplicados:', 20, yPos);
            yPos += 8;
            
            pdf.setFontSize(10);
            let filtrosTexto = [];
            if (filtros.empresa) filtrosTexto.push(`Empresa: ${filtros.empresa}`);
            if (filtros.tecnico) filtrosTexto.push(`Técnico: ${filtros.tecnico}`);
            if (filtros.tipoFalla) filtrosTexto.push(`Tipo de Falla: ${filtros.tipoFalla}`);
            if (filtros.estado) filtrosTexto.push(`Estado: ${filtros.estado}`);
            if (filtros.fechaInicio) filtrosTexto.push(`Periodo: ${filtros.fechaInicio} al ${filtros.fechaFin}`);
            
            if (filtrosTexto.length === 0) {
                filtrosTexto.push('Sin filtros aplicados');
            }
            
            filtrosTexto.forEach(texto => {
                pdf.text(`• ${texto}`, 25, yPos);
                yPos += 6;
            });
            
            yPos += 10;
            
            // Métricas principales
            pdf.setFontSize(14);
            pdf.setTextColor(171, 9, 106); // accent-color
            pdf.text('Métricas Principales', 20, yPos);
            yPos += 10;
            
            const totalTickets = tickets.length;
            const abiertas = tickets.filter(t => t.estado === 'abierto').length;
            const enEspera = tickets.filter(t => t.estado === 'espera').length;
            const cerradas = tickets.filter(t => t.estado === 'cerrado' || t.estado === 'resuelto').length;
            
            // Dibujar métricas
            pdf.setFontSize(11);
            pdf.setTextColor(51, 51, 51);
            
            const metricWidth = (pageWidth - 40) / 4;
            const metrics = [
                { label: 'Total', value: totalTickets, color: [26, 41, 128] },
                { label: 'Abiertas', value: abiertas, color: [231, 76, 60] },
                { label: 'En Espera', value: enEspera, color: [243, 156, 18] },
                { label: 'Cerradas', value: cerradas, color: [39, 174, 96] }
            ];
            
            metrics.forEach((metric, index) => {
                const xPos = 20 + (index * metricWidth);
                
                // Fondo
                pdf.setFillColor(245, 245, 245);
                pdf.rect(xPos, yPos, metricWidth - 5, 20, 'F');
                
                // Borde
                pdf.setDrawColor(171, 9, 106, 50);
                pdf.rect(xPos, yPos, metricWidth - 5, 20);
                
                // Valor
                pdf.setFontSize(16);
                pdf.setTextColor(...metric.color);
                pdf.text(metric.value.toString(), xPos + (metricWidth - 5) / 2, yPos + 10, { align: 'center' });
                
                // Etiqueta
                pdf.setFontSize(9);
                pdf.setTextColor(102, 102, 102);
                pdf.text(metric.label, xPos + (metricWidth - 5) / 2, yPos + 16, { align: 'center' });
            });
            
            yPos += 30;
            
            // Verificar si hay espacio para más contenido
            if (yPos > 250) {
                pdf.addPage();
                yPos = 20;
            }
            
            // Tabla de tickets
            pdf.setFontSize(14);
            pdf.setTextColor(171, 9, 106);
            pdf.text('Detalle de Incidencias', 20, yPos);
            yPos += 10;
            
            // Cabecera de tabla
            pdf.setFontSize(9);
            pdf.setTextColor(255, 255, 255);
            pdf.setFillColor(26, 41, 128);
            pdf.rect(20, yPos, pageWidth - 40, 8, 'F');
            
            const columnWidths = [30, 25, 25, 20, 45, 25];
            const headers = ['Técnico', 'Fecha', 'Empresa', 'Tiempo', 'Tipo Falla', 'Estado'];
            
            let xPos = 22;
            headers.forEach((header, index) => {
                pdf.text(header, xPos, yPos + 6);
                xPos += columnWidths[index];
            });
            
            yPos += 10;
            
            // Filas de la tabla
            pdf.setFontSize(8);
            pdf.setTextColor(51, 51, 51);
            
            // Limitar a 20 tickets para el PDF
            const ticketsParaPDF = tickets.slice(0, 20);
            
            ticketsParaPDF.forEach((ticket, index) => {
                if (yPos > 270) {
                    pdf.addPage();
                    yPos = 20;
                }
                
                // Fondo alternado
                if (index % 2 === 0) {
                    pdf.setFillColor(250, 250, 250);
                    pdf.rect(20, yPos, pageWidth - 40, 7, 'F');
                }
                
                // Datos
                xPos = 22;
                const rowData = [
                    ticket.tecnico.substring(0, 12),
                    ticket.fecha,
                    ticket.empresa.substring(0, 8),
                    ticket.tiempo,
                    ticket.tipoFalla.substring(0, 25),
                    ticket.estadoTexto
                ];
                
                rowData.forEach((data, dataIndex) => {
                    pdf.text(data, xPos, yPos + 5);
                    xPos += columnWidths[dataIndex];
                });
                
                yPos += 7;
            });
            
            // Pie de página
            pdf.addPage();
            yPos = 20;
            
            // Métricas por empresa
            pdf.setFontSize(14);
            pdf.setTextColor(171, 9, 106);
            pdf.text('Métricas por Empresa', 20, yPos);
            yPos += 10;
            
            const statsPorEmpresa = {};
            empresas.forEach(empresa => {
                const ticketsEmpresa = tickets.filter(t => t.empresa === empresa);
                if (ticketsEmpresa.length > 0) {
                    statsPorEmpresa[empresa] = {
                        total: ticketsEmpresa.length,
                        abiertos: ticketsEmpresa.filter(t => t.estado === 'abierto').length,
                        cerrados: ticketsEmpresa.filter(t => t.estado === 'cerrado' || t.estado === 'resuelto').length
                    };
                }
            });
            
            pdf.setFontSize(10);
            Object.entries(statsPorEmpresa).forEach(([empresa, stats], index) => {
                if (yPos > 270) {
                    pdf.addPage();
                    yPos = 20;
                }
                
                pdf.setTextColor(51, 51, 51);
                pdf.text(`${empresa}:`, 25, yPos);
                
                pdf.setTextColor(102, 102, 102);
                pdf.text(`Total: ${stats.total} | Abiertos: ${stats.abiertos} | Cerrados: ${stats.cerrados}`, 80, yPos);
                
                yPos += 7;
            });
            
            yPos += 10;
            
            // Métricas por técnico
            pdf.setFontSize(14);
            pdf.setTextColor(171, 9, 106);
            pdf.text('Rendimiento por Técnico', 20, yPos);
            yPos += 10;
            
            const statsPorTecnico = {};
            tickets.forEach(ticket => {
                if (!statsPorTecnico[ticket.tecnico]) {
                    statsPorTecnico[ticket.tecnico] = {
                        total: 0,
                        tiempo: 0,
                        resueltos: 0
                    };
                }
                statsPorTecnico[ticket.tecnico].total++;
                statsPorTecnico[ticket.tecnico].tiempo += parseFloat(ticket.tiempo);
                if (ticket.estado === 'cerrado' || ticket.estado === 'resuelto') {
                    statsPorTecnico[ticket.tecnico].resueltos++;
                }
            });
            
            pdf.setFontSize(10);
            Object.entries(statsPorTecnico).forEach(([tecnico, stats]) => {
                if (yPos > 270) {
                    pdf.addPage();
                    yPos = 20;
                }
                
                const eficiencia = ((stats.resueltos / stats.total) * 100).toFixed(1);
                const tiempoPromedio = (stats.tiempo / stats.total).toFixed(1);
                
                pdf.setTextColor(51, 51, 51);
                pdf.text(`${tecnico}:`, 25, yPos);
                
                pdf.setTextColor(102, 102, 102);
                pdf.text(`Tickets: ${stats.total} | Eficiencia: ${eficiencia}% | Tiempo Prom: ${tiempoPromedio}h`, 80, yPos);
                
                yPos += 7;
            });
            
            // Pie de página final
            pdf.addPage();
            yPos = 20;
            
            pdf.setFontSize(16);
            pdf.setTextColor(26, 41, 128);
            pdf.text('Resumen Ejecutivo', pageWidth / 2, yPos, { align: 'center' });
            yPos += 15;
            
            pdf.setFontSize(11);
            pdf.setTextColor(51, 51, 51);
            
            const resumen = [
                `• Total de incidencias analizadas: ${totalTickets}`,
                `• Incidencias abiertas: ${abiertas} (${totalTickets > 0 ? ((abiertas/totalTickets)*100).toFixed(1) : 0}%)`,
                `• Incidencias en espera: ${enEspera} (${totalTickets > 0 ? ((enEspera/totalTickets)*100).toFixed(1) : 0}%)`,
                `• Incidencias resueltas: ${cerradas} (${totalTickets > 0 ? ((cerradas/totalTickets)*100).toFixed(1) : 0}%)`,
                `• Tiempo promedio de resolución: ${totalTickets > 0 ? (tickets.reduce((sum, t) => sum + parseFloat(t.tiempo), 0) / totalTickets).toFixed(1) : 0} horas`
            ];
            
            resumen.forEach(texto => {
                pdf.text(texto, 30, yPos);
                yPos += 8;
            });
            
            yPos += 10;
            
            // Recomendaciones
            pdf.setFontSize(14);
            pdf.setTextColor(171, 9, 106);
            pdf.text('Recomendaciones', 20, yPos);
            yPos += 10;
            
            pdf.setFontSize(11);
            pdf.setTextColor(51, 51, 51);
            
            const recomendaciones = [
                '1. Priorizar incidencias abiertas con mayor tiempo de espera',
                '2. Revisar tickets en espera de refacción',
                '3. Analizar tendencias por tipo de falla',
                '4. Evaluar carga de trabajo por técnico',
                '5. Optimizar tiempos de respuesta'
            ];
            
            recomendaciones.forEach(texto => {
                pdf.text(texto, 25, yPos);
                yPos += 8;
            });
            
            // Firma
            yPos = 250;
            pdf.setFontSize(10);
            pdf.setTextColor(102, 102, 102);
            pdf.text('________________________________', pageWidth / 2, yPos, { align: 'center' });
            pdf.text('Administrador del Sistema', pageWidth / 2, yPos + 7, { align: 'center' });
            pdf.text(`Reporte generado el ${new Date().toLocaleDateString('es-ES')}`, pageWidth / 2, yPos + 14, { align: 'center' });
            
            // Guardar PDF
            const nombreArchivo = `reporte-incidencias-${new Date().toISOString().split('T')[0]}.pdf`;
            pdf.save(nombreArchivo);
            
            // Mostrar confirmación
            showNotification('✅ Reporte PDF generado y descargado exitosamente', 'success');
        }
        
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 20px;
                border-radius: 8px;
                color: white;
                font-weight: 600;
                z-index: 10000;
                animation: slideIn 0.3s ease-out;
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                display: flex;
                align-items: center;
                gap: 10px;
                max-width: 350px;
            `;
            
            if (type === 'success') {
                notification.style.background = 'linear-gradient(135deg, var(--accent-color), #8A0755)';
                notification.innerHTML = `<i class="fas fa-check-circle"></i> ${message}`;
            } else {
                notification.style.background = 'linear-gradient(135deg, #3498db, var(--accent-color))';
                notification.innerHTML = `<i class="fas fa-info-circle"></i> ${message}`;
            }
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease-out';
                setTimeout(() => {
                    document.body.removeChild(notification);
                }, 300);
            }, 3000);
        }
        
        // Animación CSS para notificaciones
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
