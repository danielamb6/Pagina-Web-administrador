        function getEstadoColor(estado) {
            const colores = {
                'abierto': '#e74c3c, #c0392b',
                'espera': '#f39c12, #f1c40f',
                'cerrado': '#27ae60, #2ecc71',
                'resuelto': '#27ae60, #2ecc71',
                'pendiente': '#f39c12, #f1c40f'
            };
            return colores[estado] || '#3498db, #2980b9';
        }
        
