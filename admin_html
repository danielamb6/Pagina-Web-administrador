    <script>
        // Variables globales
        let ticketsData = [];
        let chartInstances = [];
        
        // Datos de ejemplo para demostración
        const empresas = ['Zoxo', 'Codiversa', 'Copesa', 'Sitraq', 'Corevsa'];
        const tecnicos = ['Juan Pérez', 'María Gómez', 'Carlos Rodríguez', 'Ana López'];
        const tiposFalla = [
            'EQUIPOS - MDVR',
            'ELEMENTOS - Cámara Operador',
            'ACCESORIOS - Antena GPS',
            'FALLA REPORTADA - No accesa',
            'SOLUCIÓN - Se restablece conexión',
            'CONFIGURACIÓN - Parámetros GPS',
            'HARDWARE - Tarjeta SIM'
        ];
        const estados = ['abierto', 'espera', 'cerrado', 'resuelto', 'pendiente'];
        const estadosTexto = ['Abierto', 'En Espera', 'Cerrado', 'Resuelto', 'Pendiente'];
        
        // Inicializar la aplicación
        document.addEventListener('DOMContentLoaded', function() {
            inicializarFechas();
            inicializarDatos();
            inicializarEventos();
            actualizarVista();
        });
        
        function inicializarFechas() {
            const hoy = new Date();
            const hace30Dias = new Date();
            hace30Dias.setDate(hoy.getDate() - 30);
            
            document.getElementById('fecha-inicio').value = hace30Dias.toISOString().split('T')[0];
            document.getElementById('fecha-fin').value = hoy.toISOString().split('T')[0];
        }
        
        function inicializarDatos() {
            // Generar datos de ejemplo
            ticketsData = [];
            const hoy = new Date();
            
            for (let i = 1; i <= 48; i++) {
                const fecha = new Date();
                fecha.setDate(hoy.getDate() - Math.floor(Math.random() * 30));
                
                const estadoIndex = Math.floor(Math.random() * estados.length);
                const estado = estados[estadoIndex];
                const estadoTexto = estadosTexto[estadoIndex];
                
                ticketsData.push({
                    id: i,
                    tecnico: tecnicos[Math.floor(Math.random() * tecnicos.length)],
                    fecha: fecha.toLocaleDateString('es-ES'),
                    empresa: empresas[Math.floor(Math.random() * empresas.length)],
                    tiempo: (Math.random() * 5 + 0.5).toFixed(1) + 'h',
                    tipoFalla: tiposFalla[Math.floor(Math.random() * tiposFalla.length)],
                    estado: estado,
                    estadoTexto: estadoTexto
                });
            }
        }
        
        function inicializarEventos() {
            // Evento para limpiar filtros
            document.getElementById('limpiar-filtros').addEventListener('click', function() {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);
                
                document.getElementById('empresa').value = '';
                document.getElementById('tecnico').value = '';
                document.getElementById('tipo-falla').value = '';
                document.getElementById('estado').value = '';
                
                const hoy = new Date();
                const hace30Dias = new Date();
                hace30Dias.setDate(hoy.getDate() - 30);
                
                document.getElementById('fecha-inicio').value = hace30Dias.toISOString().split('T')[0];
                document.getElementById('fecha-fin').value = hoy.toISOString().split('T')[0];
                
                actualizarVista();
                showNotification('Filtros limpiados correctamente', 'success');
            });
            
            // Evento para actualizar vista
            document.getElementById('generar-reporte').addEventListener('click', function() {
                this.classList.add('loading');
                setTimeout(() => {
                    this.classList.remove('loading');
                    actualizarVista();
                    showNotification('Vista actualizada con los filtros aplicados', 'success');
                }, 500);
            });
            
            // Evento para generar PDF
            document.getElementById('generar-pdf').addEventListener('click', function() {
                this.classList.add('loading');
                setTimeout(() => {
                    this.classList.remove('loading');
                    generarReportePDF();
                }, 500);
            });
            
            // Evento para cerrar modal
            document.getElementById('close-modal').addEventListener('click', function() {
                document.getElementById('pdf-preview-modal').style.display = 'none';
            });
            
            // Cerrar modal al hacer clic fuera
            document.getElementById('pdf-preview-modal').addEventListener('click', function(e) {
                if (e.target === this) {
                    this.style.display = 'none';
                }
            });
            
            // Logo placeholder
            const logoImg = document.querySelector('.logo-img');
            const logoPlaceholder = document.getElementById('logo-placeholder');
            
            if (logoImg.complete && logoImg.naturalHeight !== 0) {
                logoPlaceholder.style.display = 'none';
            }
            
            logoImg.onerror = function() {
                logoPlaceholder.style.display = 'flex';
                this.style.display = 'none';
            };
        }
        
        function actualizarVista() {
            const filtros = obtenerFiltros();
            const ticketsFiltrados = filtrarTickets(filtros);
            
            actualizarTabla(ticketsFiltrados);
            actualizarEstadisticas(ticketsFiltrados);
        }
        
        function obtenerFiltros() {
            return {
                empresa: document.getElementById('empresa').value,
                tecnico: document.getElementById('tecnico').value,
                tipoFalla: document.getElementById('tipo-falla').value,
                estado: document.getElementById('estado').value,
                fechaInicio: document.getElementById('fecha-inicio').value,
                fechaFin: document.getElementById('fecha-fin').value
            };
        }
        
        function filtrarTickets(filtros) {
            return ticketsData.filter(ticket => {
                // Filtrar por empresa
                if (filtros.empresa && !ticket.empresa.toLowerCase().includes(filtros.empresa.toLowerCase())) {
                    return false;
                }
                
                // Filtrar por técnico
                if (filtros.tecnico) {
                    const tecnicoKey = ticket.tecnico.toLowerCase().replace(' ', '_');
                    if (tecnicoKey !== filtros.tecnico) return false;
                }
                
                // Filtrar por tipo de falla
                if (filtros.tipoFalla && !ticket.tipoFalla.toLowerCase().includes(filtros.tipoFalla.toLowerCase())) {
                    return false;
                }
                
                // Filtrar por estado
                if (filtros.estado && ticket.estado !== filtros.estado) {
                    return false;
                }
                
                // Filtrar por fecha
                if (filtros.fechaInicio || filtros.fechaFin) {
                    const ticketFecha = new Date(ticket.fecha.split('/').reverse().join('-'));
                    
                    if (filtros.fechaInicio) {
                        const fechaInicio = new Date(filtros.fechaInicio);
                        if (ticketFecha < fechaInicio) return false;
                    }
                    
                    if (filtros.fechaFin) {
                        const fechaFin = new Date(filtros.fechaFin);
                        fechaFin.setHours(23, 59, 59);
                        if (ticketFecha > fechaFin) return false;
                    }
                }
                
                return true;
            });
        }
        
        function actualizarTabla(tickets) {
            const tbody = document.getElementById('tickets-body');
            tbody.innerHTML = '';
            
            tickets.forEach(ticket => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${ticket.tecnico}</td>
                    <td>${ticket.fecha}</td>
                    <td><span class="empresa-badge">${ticket.empresa}</span></td>
                    <td>${ticket.tiempo}</td>
                    <td>${ticket.tipoFalla}</td>
                    <td><span class="status-badge status-${ticket.estado}">${ticket.estadoTexto}</span></td>
                    <td>
                        <select class="status-select" data-ticket="${ticket.id}" data-tooltip="Cambiar estado del ticket">
                            <option value="abierto" ${ticket.estado === 'abierto' ? 'selected' : ''}>Abierto</option>
                            <option value="espera" ${ticket.estado === 'espera' ? 'selected' : ''}>En Espera</option>
                            <option value="cerrado" ${ticket.estado === 'cerrado' ? 'selected' : ''}>Cerrado</option>
                            <option value="resuelto" ${ticket.estado === 'resuelto' ? 'selected' : ''}>Resuelto</option>
                            <option value="pendiente" ${ticket.estado === 'pendiente' ? 'selected' : ''}>Pendiente</option>
                        </select>
                    </td>
                `;
                tbody.appendChild(row);
            });
            
            // Agregar eventos a los selectores de estado
            document.querySelectorAll('.status-select').forEach(select => {
                select.addEventListener('change', function() {
                    const ticketId = parseInt(this.dataset.ticket);
                    const nuevoEstado = this.value;
                    cambiarEstadoTicket(ticketId, nuevoEstado);
                });
            });
            
            // Efectos hover en filas
            document.querySelectorAll('#tickets-body tr').forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.01)';
                    this.style.boxShadow = '0 5px 15px rgba(0,0,0,0.1)';
                });
                
                row.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1)';
                    this.style.boxShadow = 'none';
                });
            });
        }
        
        function actualizarEstadisticas(tickets) {
            // Actualizar contador total
            document.getElementById('total-incidencias').textContent = tickets.length;
            
            // Contar por estado
            const abiertas = tickets.filter(t => t.estado === 'abierto').length;
            const enEspera = tickets.filter(t => t.estado === 'espera').length;
            const cerradas = tickets.filter(t => t.estado === 'cerrado').length;
            const resueltas = tickets.filter(t => t.estado === 'resuelto').length;
            const pendientes = tickets.filter(t => t.estado === 'pendiente').length;
            
            // Actualizar contadores
            document.getElementById('abiertas-count').textContent = abiertas;
            document.getElementById('espera-count').textContent = enEspera;
            document.getElementById('cerradas-count').textContent = cerradas + resueltas;
            
            // Calcular tiempo promedio
            if (tickets.length > 0) {
                const totalTiempo = tickets.reduce((sum, ticket) => {
                    return sum + parseFloat(ticket.tiempo);
                }, 0);
                const promedio = (totalTiempo / tickets.length).toFixed(1);
                document.querySelector('.summary-card:nth-child(4) h3').textContent = promedio + 'h';
            }
        }
        
        function cambiarEstadoTicket(ticketId, nuevoEstado) {
            const ticket = ticketsData.find(t => t.id === ticketId);
            if (ticket) {
                const estadoAnterior = ticket.estado;
                ticket.estado = nuevoEstado;
                ticket.estadoTexto = nuevoEstado.charAt(0).toUpperCase() + nuevoEstado.slice(1);
                
                // Actualizar vista
                actualizarVista();
                
                // Mostrar notificación
                showNotification(`Ticket #${ticketId} cambió de ${estadoAnterior} a ${nuevoEstado}`, 'success');
            }
        }
        
        function generarReportePDF() {
            const filtros = obtenerFiltros();
            const ticketsFiltrados = filtrarTickets(filtros);
            
            // Mostrar modal con vista previa
            mostrarVistaPreviaPDF(ticketsFiltrados, filtros);
            
            // Generar PDF real
            setTimeout(() => {
                generarPDFReal(ticketsFiltrados, filtros);
            }, 1000);
        }
        
        function mostrarVistaPreviaPDF(tickets, filtros) {
            const modal = document.getElementById('pdf-preview-modal');
            const content = document.getElementById('pdf-content');
            
            // Limpiar gráficos anteriores
            chartInstances.forEach(chart => chart.destroy());
            chartInstances = [];
            
            // Generar contenido HTML para la vista previa
            content.innerHTML = generarContenidoPDF(tickets, filtros);
            
            // Mostrar modal
            modal.style.display = 'flex';
            
            // Inicializar gráficos
            inicializarGraficosPDF();
        }
        
        function generarContenidoPDF(tickets, filtros) {
            const fechaGeneracion = new Date().toLocaleString('es-ES');
            const totalTickets = tickets.length;
            
            // Estadísticas por empresa
            const statsPorEmpresa = {};
            empresas.forEach(empresa => {
                const ticketsEmpresa = tickets.filter(t => t.empresa === empresa);
                statsPorEmpresa[empresa] = {
                    total: ticketsEmpresa.length,
                    abiertos: ticketsEmpresa.filter(t => t.estado === 'abierto').length,
                    enEspera: ticketsEmpresa.filter(t => t.estado === 'espera').length,
                    cerrados: ticketsEmpresa.filter(t => t.estado === 'cerrado').length,
                    resueltos: ticketsEmpresa.filter(t => t.estado === 'resuelto').length,
                    pendientes: ticketsEmpresa.filter(t => t.estado === 'pendiente').length
                };
            });
            
            // Estadísticas por técnico
